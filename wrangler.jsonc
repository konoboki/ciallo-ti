{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciallo-ti",
  "compatibility_date": "2026-04-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciallo-ti-ratings",
      "database_id": "6053966c-933e-4670-966f-562b9fef2daa"
    }
  ]
